# NOTE: this is meant to be a simple config file for non-programmers
#       to be able to configure some of the redux for themselves.
#       Only the below values are supported, so adding more wont work.
#       if you would like control over the remaining config, you
#       will need to modify the config.s and ringConfig.s ASM files.
# NOTE: To disable or enable a feature, either add or remove
#       the character '#' at the front of the line to either
#       covert it to a comment, or to a statement.
# NOTE: DO NOT add spaces around the '=' or this file will break.

# automatically enables the following features:
#   ENABLE_RING_REDUX, ENABLE_REDUX_EXTRAS
#   EXTENDED_RING_BOX, RESIZE_RING_BOX
ENABLE_FULL_REDUX=1

# automatically enables the following features:
#   ENABLE_PUNCH_WITH_ITEM, ENABLE_DOUBLE_HEART_CAP
#   NEW_GAME_PLUS_NEEDS_COMPLETION, MORE_RUPEE_TYPES
#   FILE_MENU_SHOW_CURRENT_HEARTS, ENABLE_QUICK_ITEM_DROP
#   ENABLE_PORTAL_RING_BOX, INCREASE_WALLET_SIZE
#   REMAP_RING_LIST, UNRESTRICTED_TRANSFORMS
#   PORTAL_RING_BOX_LEVEL, MAGNET_GLOVES_CAN_PUSH_ENEMIES
ENABLE_REDUX_EXTRAS=1

# determines whether the ring redux overhaul is enabled.
# to learn how it works, look at 'notes/ringRedux*.txt'
# also automatically enables the following required features:
#   ENABLE_PORTAL_RING_BOX, ENABLE_MULTI_RING
#   ENABLE_PUNCH_WITH_ITEM
ENABLE_RING_REDUX=1

# determines whether to enable creating NG+ files
ENABLE_NEW_GAME_PLUS=1

# determines whether to use the DX title screen or not
ENABLE_DX_TITLE_SCREEN=1

# determines whether to include an additional 2 message speeds
MORE_MESSAGE_SPEEDS=1